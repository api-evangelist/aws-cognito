          "request": {
            "name": "Amazon Cognito Get Signing Certificate",
            "description": {
              "content": "<p>This method takes a user pool ID, and returns the signing certificate. The issued certificate is valid for 10 years from the date of issue.</p> <p>Amazon Cognito issues and assigns a new signing certificate annually. This process returns a new value in the response to <code>GetSigningCertificate</code>, but doesn't invalidate the original certificate.</p>",
              "type": "text/plain"
            },
