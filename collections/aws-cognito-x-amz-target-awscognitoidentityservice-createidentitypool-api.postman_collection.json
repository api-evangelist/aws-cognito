            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"IdentityPoolName\": \"<string>\",\n  \"AllowUnauthenticatedIdentities\": \"<boolean>\",\n  \"AllowClassicFlow\": \"<boolean>\",\n  \"SupportedLoginProviders\": {\n    \"key_0\": \"<string>\",\n    \"key_1\": \"<string>\",\n    \"key_2\": \"<string>\",\n    \"key_3\": \"<string>\",\n    \"key_4\": \"<string>\",\n    \"key_5\": \"<string>\"\n  },\n  \"DeveloperProviderName\": \"<string>\",\n  \"OpenIdConnectProviderARNs\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"CognitoIdentityProviders\": [\n    {\n      \"ProviderName\": \"<string>\",\n      \"ClientId\": \"<string>\",\n      \"ServerSideTokenCheck\": \"<boolean>\"\n    },\n    {\n      \"ProviderName\": \"<string>\",\n      \"ClientId\": \"<string>\",\n      \"ServerSideTokenCheck\": \"<boolean>\"\n    }\n  ],\n  \"SamlProviderARNs\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"IdentityPoolTags\": {\n    \"key_0\": \"<string>\",\n    \"key_1\": \"<string>\",\n    \"key_2\": \"<string>\"\n  }\n}",
