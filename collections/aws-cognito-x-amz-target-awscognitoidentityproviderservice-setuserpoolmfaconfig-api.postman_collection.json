              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"UserPoolId\": \"<string>\",\n  \"SmsMfaConfiguration\": {\n    \"SmsAuthenticationMessage\": \"<string>\",\n    \"SmsConfiguration\": {\n      \"SnsCallerArn\": \"<string>\",\n      \"ExternalId\": \"<string>\",\n      \"SnsRegion\": \"<string>\"\n    }\n  },\n  \"SoftwareTokenMfaConfiguration\": {\n    \"Enabled\": \"<boolean>\"\n  },\n  \"MfaConfiguration\": \"<string>\"\n}",
